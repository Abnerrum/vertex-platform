# Exemplo para rodar a API com PostgreSQL (docker compose up -d db).
# A aplicação lê o arquivo .env de dentro de backend/, então copie este
# conteúdo para backend/.env quando quiser usar o banco do Docker.
# Para desenvolvimento rápido com SQLite, use backend/.env.example.
DATABASE_URL=postgresql+psycopg://vertex:vertex@localhost:5432/vertex
SECRET_KEY=troque-por-um-segredo-aleatorio-de-no-minimo-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
